{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "sequelize": "node --import tsx ./node_modules/sequelize-cli/lib/sequelize",
    "db:migrate": "npm run sequelize -- db:migrate",
    "db:migrate:undo": "npm run sequelize -- db:migrate:undo",
    "db:migrate:undo:all": "npm run sequelize -- db:migrate:undo:all",
    "db:seed": "npm run sequelize -- db:seed:all",
    "db:seed:undo": "npm run sequelize -- db:seed:undo:all"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
