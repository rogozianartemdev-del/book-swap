    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "sequelize-cli": "^6.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
